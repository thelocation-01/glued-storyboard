{
  "name": "glued-storyboard-studio",
  "version": "1.1.0",
  "description": "A local script-to-video storyboard editor with Kokoro Bella narration and stable cinematic photo motion.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelocation-01/glued-storyboard.git"
  },
  "homepage": "https://github.com/thelocation-01/glued-storyboard#readme",
  "keywords": [
    "storyboard",
    "video-editor",
    "remotion",
    "kokoro",
    "text-to-speech",
    "faceless-video",
    "youtube"
  ],
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "check": "tsc --noEmit",
    "validate-release": "node scripts/validate-release.mjs",
    "verify": "pnpm check && pnpm validate-release"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.506",
    "@remotion/media": "4.0.506",
    "@remotion/renderer": "4.0.506",
    "adm-zip": "^0.5.16",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.506"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
